async function biometricUnlock(){
 if(!window.PublicKeyCredential||!navigator.credentials){toast("Biometric needs HTTPS + supported device");return}
 try{
   let raw=localStorage.getItem(BIO_KEY);
   if(!raw){
     const challenge=crypto.getRandomValues(new Uint8Array(32));
     const cred=await navigator.credentials.create({publicKey:{challenge,rp:{name:"JAGESH ELECTRONIC"},user:{id:crypto.getRandomValues(new Uint8Array(16)),name:"jagesh",displayName:"JAGESH ELECTRONIC"},pubKeyCredParams:[{type:"public-key",alg:-7},{type:"public-key",alg:-257}],authenticatorSelection:{authenticatorAttachment:"platform",userVerification:"required"},timeout:60000}});
     if(!cred)throw Error("No credential");
     localStorage.setItem(BIO_KEY,btoa(String.fromCharCode(...new Uint8Array(cred.rawId))));
     unlockOK();toast("Fingerprint unlocked");
   }else{
     const id=Uint8Array.from(atob(raw),c=>c.charCodeAt(0));
     await navigator.credentials.get({publicKey:{challenge:crypto.getRandomValues(new Uint8Array(32)),allowCredentials:[{type:"public-key",id}],userVerification:"required"},mediation:"required"});
     unlockOK();toast("Biometric unlocked");
   }
 }catch(e){toast("Biometric failed — use PIN")}
}

