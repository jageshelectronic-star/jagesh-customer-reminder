 finally{
   cloudSyncInFlight=false;
   if(cloudSyncQueued){cloudSyncQueued=false;syncCloudState();}
 }
}
async function loadCloudState(user){
 cloudReady=false;
 const localUserData=JSON.parse(localStorage.getItem(userLocalKey(user.uid)||"[]")||"[]");
 const localUserRecycle=JSON.parse(localStorage.getItem(userRecycleKey(user.uid)||"[]")||"[]");
 const snap=await firebaseDb.collection(CLOUD_COLLECTION).doc(user.uid).collection("app").doc(CLOUD_DOC).get();
 if(snap.exists){
   const v=snap.data()||{};
   data=Array.isArray(v.customers)?v.customers:[];
   recycleBin=Array.isArray(v.recycleBin)?v.recycleBin:[];
 }else{
   data=localUserData;
   recycleBin=localUserRecycle;
   const legacyData=JSON.parse(localStorage.getItem(KEY)||"[]");
   const legacyRecycle=JSON.parse(localStorage.getItem(RECYCLE_KEY)||"[]");
   if(!data.length && !recycleBin.length && (legacyData.length||legacyRecycle.length)){
     const ok=confirm("इस Email के लिए Firebase Cloud में अभी कोई data नहीं है। क्या इस device का पुराना V25 Customer Data इसी logged-in Email में Import करना है?\n\nOK = Import\nCancel = नया खाली Cloud Account");
     if(ok){data=legacyData;recycleBin=legacyRecycle;}
   }
   localStorage.setItem(userLocalKey(user.uid),JSON.stringify(data));
   localStorage.setItem(userRecycleKey(user.uid),JSON.stringify(recycleBin));
   cloudReady=true;
