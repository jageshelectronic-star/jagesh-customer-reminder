let locationWatchId=null;
let gpsRequestId=0;
function getFreshGPS(){
 return new Promise((resolve,reject)=>{
   if(!navigator.geolocation){reject({code:0,message:'Geolocation not supported'});return}
   const requestId=++gpsRequestId;
   let finished=false, best=null, timer=null;
   const finish=(fn,v)=>{
     if(finished||requestId!==gpsRequestId)return;
     finished=true;
     if(timer)clearTimeout(timer);
     if(locationWatchId!==null){try{navigator.geolocation.clearWatch(locationWatchId)}catch(e){} locationWatchId=null;}
     fn(v);
   };
   const success=p=>{
     const lat=Number(p.coords.latitude), lon=Number(p.coords.longitude);
     const accuracy=Math.round(Number(p.coords.accuracy)||999999);
     if(!Number.isFinite(lat)||!Number.isFinite(lon))return;
     const fix={lat:lat.toFixed(7),lon:lon.toFixed(7),accuracy,timestamp:Date.now()};
     if(!best || accuracy<best.accuracy)best=fix;
     // Accept a reasonably accurate fix immediately; otherwise keep watching briefly.
     if(accuracy<=50) finish(resolve,fix);
   };
   const fail=e=>{
     // Don't fail on a temporary GPS reading problem; timeout below gets a useful error.
     if(e && e.code===1) finish(reject,e);
   };
   try{
     locationWatchId=navigator.geolocation.watchPosition(success,fail,{
       enableHighAccuracy:true, timeout:15000, maximumAge:0
     });
     timer=setTimeout(()=>{
       if(best) finish(resolve,best);
       else {
         // One direct request as a fallback for browsers/WebViews that don't stream watch fixes.
         navigator.geolocation.getCurrentPosition(
           p=>success(p),
           e=>finish(reject,e||{code:3}),
           {enableHighAccuracy:true,timeout:12000,maximumAge:0}
         );
       }
     },7000);
   }catch(e){finish(reject,e)}
 });
}
async function saveCurrentLocation(prefix){
 const field=$(prefix+"Location");
 if(!window.isSecureContext && location.protocol!=='https:'){
   toast('⚠️ GPS के लिए HTTPS/PWA में ऐप खोलें');
   return;
 }
 if(!navigator.geolocation){toast('इस browser में GPS उपलब्ध नहीं है');return}
 toast('📡 आपकी वर्तमान GPS Location खोजी जा रही है…');
 try{
   const p=await getFreshGPS();
   pendingLocation={lat:p.lat,lon:p.lon,accuracy:p.accuracy,source:'device-gps',timestamp:p.timestamp};
   if(field) field.value=`${p.lat}, ${p.lon} (GPS ±${p.accuracy}m)`;
   toast(`✅ Current Location Save हो गई (±${p.accuracy}m)`);
 }catch(e){
   let msg='Location नहीं मिली। Phone की Location ON करके फिर कोशिश करें।';
   if(e&&e.code===1) msg='📍 Location Permission को Allow करें, फिर Current Location दबाएँ।';
   else if(e&&e.code===3) msg='📡 GPS मिलने में समय लगा। खुले स्थान पर फिर कोशिश करें।';
   toast(msg);
 }
}
