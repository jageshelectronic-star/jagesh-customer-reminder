function getCustomerSalutation(name){
 const n=String(name||"").trim().toLowerCase().replace(/\s+/g," ");
 if(/^(mr\.?|mister|shri|sh\.?|श्री)\s+/i.test(n)) return "Sir";
 if(/^(mrs\.?|ms\.?|miss|smt\.?|smti\.?|श्रीमती|सुश्री|श्री\s*मति)\s+/i.test(n)) return "Madam";
 const first=n.split(/\s+/)[0].replace(/[^a-z]/g,"");
 const femaleNames=new Set(["aarti","anjali","anita","anju","archana","asha","babita","bhavna","deepa","deepika","divya","garima","geeta","gita","kajal","kalpana","kamini","kavita","komal","lakshmi","laxmi","madhu","manisha","meena","meenakshi","monika","monika","neha","neetu","nikita","nisha","pooja","puja","pragya","preeti","priyanka","radha","rakhi","rekha","richa","ritu","riya","ruchi","sakshi","seema","shalini","shikha","shreya","simran","sonali","sonam","suman","sunita","swati","tanvi","usha","vandana","varsha","vidya","yogita"]);
 if(femaleNames.has(first) || /(?:a|i|ee|ya|ika|ita|ini|sha|thi)$/.test(first)) return "Madam";
 return "Sir";
}
