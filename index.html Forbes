}
function restoreCustomer(i){
 const c=recycleBin[Number(i)]; if(!c)return;
 const restored={...c}; delete restored._deletedAt;
 if(data.some(x=>String(x.id)===String(restored.id))) restored.id=Date.now()+Math.floor(Math.random()*1000);
 data.push(restored); recycleBin.splice(Number(i),1); saveRecycle(); save(); renderRecycle(); toast('↩️ Customer Restore हो गया');
}
function permanentDelete(i){
 if(!confirm('इस Customer को हमेशा के लिए Delete करना है? यह वापस नहीं आएगा।'))return;
 recycleBin.splice(Number(i),1); saveRecycle(); renderRecycle(); toast('Customer permanently deleted');
}
