 const html=recycleBin.map((c,i)=>`<div class="recycle-item"><div><b>${esc(c.name||"Customer")}</b><div style="font-size:13px;color:#666;margin-top:5px">${esc(c.phone||"")}</div>${c._deletedAt?`<div style="font-size:12px;color:#777;margin-top:3px">Deleted: ${new Date(c._deletedAt).toLocaleString()}</div>`:""}</div><div class="recycle-actions"><button class="mini" data-restore-customer="${i}" style="background:#16803c;color:#fff">↩️ Restore</button><button class="mini" data-permanent-delete="${i}" style="background:#b91c1c;color:#fff">🗑️ Delete Forever</button></div></div>`).join('');
